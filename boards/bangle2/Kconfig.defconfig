# The recovery firmware shares the 1 MiB flash bank with the normal
# firmware. It is NOT linked in the upper half -- this symbol only shrinks
# the slot LENGTH to 512K. Both variants link at the SAME origin, because
# memory.ld:35 derives ORIGIN from FLASH_BASE + FLASH_OFFSET +
# FIRMWARE_OFFSET, none of which vary by variant. A recovery image is
# therefore a drop-in replacement for the normal image at the same address,
# which is what lets a bootloader copy it from external SAFE_FIRMWARE into
# the normal firmware slot and run it there. See
# plans/2026-07-28-bangle2-r10-bootloader-design.md section 2 for why the
# copy is destructive: 32K bootloader + 836K normal + 512K PRF is 1380K
# into a 1024K part, so a second resident slot does not fit.
config FW_FLASH_SIZE
    default 0x80000 if RECOVERY_FW && !MFG
    default 0xD1000

# The firmware links behind the 32 KiB bootloader (src/boot) at 0x8000, like
# every other nRF board. The bootloader owns reset at 0x0-0x8000, selects the
# normal firmware or the PRF, and starts the chosen image here. The image spans
# 0x8000-0xD9000; the 0x27000 (156 KiB) of internal flash above it is free.
#
# The SoC default (soc/nrf/Kconfig.defconfig) is `0x8000 if !BOARD_BANGLE2`, so
# for this board the SoC default does NOT fire and this board override is what
# applies -- setting it to 0x8000 here is sufficient (verified 2026-08-01;
# changing this file alone relinks the firmware at 0x8000).
#
# COUPLED CHANGE: a firmware at 0x8000 does not boot without the bootloader
# flashed at 0x0, and the out-of-repo Renode boot harness asserts app_base==0x0
# and must be updated to match. See the R10 design doc, section 4.0.
config FLASH_OFFSET
    default 0x8000
