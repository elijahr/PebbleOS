build
# Out-of-tree build dirs from `./waf configure --out=<dir>`, e.g. the
# `--out=build-prf` used to build the prf variant without clobbering the
# normal build. `build` above does not match these, so without this line a
# `git add -A` stages a few hundred MB of build output.
# Anchored to the repo root and restricted to directories on purpose: an
# unanchored `build-*` also matches .github/workflows/build-*.yml.
/build-*/
xcode

.ycm*

.*project
*.*project
*.*workspace
.settings

*.bin
!bin/**/*.bin
*.bin.orig
*.map
build/*.elf
*.o

cscope.*
TAGS

*.swp
*.swo
*.swn

.waf*
.lock*

*.pyc
*.gch

qemu_serial.txt
uart*.log

serial_dump.txt

a.out
tools/font/ttf
roundrect.h
log.txt
.DS_Store
tools/bitmaps/*.h
tools/bitmaps/*.pbi

mfg_release/

dist
compile_commands.json
*.auto
loghash_dict.pickle
analyze_mcu_flash_usage_treemap.jsonp
**/.idea
**/CMakeLists.txt

.env

.vscode
.venv
*.egg-info

waflib.zip
*~

docs/_build
artifacts/

.claude/settings.local.json
.envrc
.direnv
