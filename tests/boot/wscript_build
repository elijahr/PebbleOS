from tools.waf.pebble_test import clar

# boot_select.h is a pure, header-only state machine; the test includes it
# directly, so no extra sources are needed. add_includes points at src/boot so
# #include "boot_select.h" resolves.
clar(
    ctx,
    sources_ant_glob=None,
    test_sources_ant_glob="test_boot_select.c",
    add_includes=["src/boot"],
)

# boot_image.h is the pure image-validation decision layer (geometry + CRC
# gates) split out of boot_main's image_validate(). Header-only; crc32() is
# linked from libutil by the clar harness.
clar(
    ctx,
    sources_ant_glob=None,
    test_sources_ant_glob="test_boot_image.c",
    add_includes=["src/boot"],
)
